# Local development database.
# `npm run db:start` creates a throwaway cluster in .pgdata and prints this URL.
DATABASE_URL=postgresql://postgres@localhost:55432/atropos_dev

# Connector credentials are never stored in Postgres — `connection.credential_ref`
# holds an opaque handle and the material lives in the secret store. Set the
# store's address here when it exists; there is deliberately nothing to put in
# this file yet.
# SECRET_STORE_URL=
